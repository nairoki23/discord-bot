{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.gcp_keys/**)",
      "Edit(**/.env)",
      "Edit(**/.gcp_keys/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git submodule add *)",
      "Bash(git submodule update *)",
      "Bash(git reset --hard *)",
      "Bash(sudo *)",
      "Bash(systemctl *)"
    ]
  }
}
